{
  "expo": {
    "name": "Status Desk",
    "slug": "omc5-admin",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "web"],
    "ios": {
      "bundleIdentifier": "ca.olund.statusdesk",
      "supportsTablet": false
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Confirm it's you before pushing to GitHub."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to add to an update."
        }
      ]
    ]
  }
}
