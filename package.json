{
  "name": "status-desk",
  "private": true,
  "version": "0.1.0",
  "description": "Clipper Status Desk: a React Native editor for the Clayton Clipper site's status.yaml, run in the Claude app through react-native-web.",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "expo": "58.0.23",
    "expo-clipboard": "58.0.4",
    "expo-image-manipulator": "58.0.16",
    "expo-image-picker": "58.0.10",
    "expo-secure-store": "58.0.2",
    "expo-sqlite": "58.0.15",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "twrnc": "4.6.1"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "prettier": "3.9.10"
  },
  "main": "index.js"
}
